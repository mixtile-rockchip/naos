#!/bin/sh

while [ ! "$(cat /sys/class/net/eth0/operstate 2>/dev/null)" = "up" ]; do
    sleep 1
done


IP_ADDR=""
COUNT=0
MAX_RETRY=100

while [ -z "$IP_ADDR" ] && [ $COUNT -lt $MAX_RETRY ]; do
    IP_ADDR=$(ip -4 addr show eth0 2>/dev/null | grep -oE 'inet [0-9.]+' | awk '{print $2}' | grep -v "169.254")

    if [ -n "$IP_ADDR" ]; then
        echo "Network Ready - eth0 IP: $IP_ADDR" > /dev/console
        break
    else
        COUNT=$((COUNT + 1))
        sleep 1
    fi
done

