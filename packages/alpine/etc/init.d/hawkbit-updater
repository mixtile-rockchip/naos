#!/sbin/openrc-run

description="Hawkbit service"
command="/usr/bin/hawkbit-updater"
command_background=true
LOG_FILE="/var/log/updater.log"
pidfile="/run/hawkbit.pid"

depend() {
	after net
}

start() {
    ebegin "Starting hawkbit-updater services"
    start-stop-daemon --start --background  --stdout "$LOG_FILE" --stderr "$LOG_FILE" --make-pidfile --pidfile "$pidfile" --exec "$command" -- --config-file /etc/update-config.conf
    eend $?
}

stop() {
    ebegin "Stopping hawkbit-updater services"
    start-stop-daemon --stop --pidfile "$pidfile"
    eend $?
}

