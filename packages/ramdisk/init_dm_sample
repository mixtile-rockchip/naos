#!/bin/sh

# devtmpfs does not get automounted for initramfs
/bin/mount -t devtmpfs devtmpfs /dev
/bin/mount -t proc proc /proc
/bin/mount -t sysfs sysfs /sys
/bin/mount -t tmpfs tmpfs /tmp

exec 1>/dev/console
exec 2>/dev/console
# exec 0</dev/console
# exec /sbin/init "$@"
SLOT_SUFIX=
SYSTEM_NAME=rootfs
BLOCK_PATH=/sys/class/block
BLOCK_TYPE_SUPPORTED="
mmcblk
flash"
MSG_OUTPUT=/dev/null
DEBUG() {
	echo $1 > $MSG_OUTPUT
}

check_device_is_supported() {
	for i in $BLOCK_TYPE_SUPPORTED
	do
		if [ ! -z "$(echo $(basename $1) | grep $i)" ]; then
			echo $1
			return 0
		fi
	done
}

find_raw_partition() {
	local target=$1
	local target_dev=
	local partname=

	DEBUG "try to find block $target"
	while true
	do
		for dev in ${BLOCK_PATH}/*
		do
			target_dev=$(check_device_is_supported $dev)
			if [ ! -z "$target_dev" ]; then
				partname=$(cat $target_dev/uevent | grep PARTNAME | sed "s#.*PARTNAME=##")
				if [ "$partname" == "$target" ]; then
					echo "$(basename $target_dev)"
					return 0
				fi
			fi
		done
	done
}

entry_factory() {
    while true; do
        for device in /dev/sd[a-z]; do
            if [ -b "$device" ]; then
                DEBUG "Found USB disk: $device"
                if mount "$device" /mnt 2>/dev/null; then
                    if [ -f "/mnt/etc/factory" ]; then
                        DEBUG "Found the correct factory USB drive: $device"
                        resize2fs "$device"
                        break 2
                    else
                        DEBUG "Not factory USB drive: $device"
                        umount /mnt 2>/dev/null
                    fi
                else
                    DEBUG "Failed to mount: $device"
                fi
            fi
        done

        DEBUG "Searching for factory USB disk, please insert the factory USB"
	sleep 1
    done
}

DEBUG "--------------------------"
DEBUG "Debug For Security Ramboot"
DEBUG "--------------------------"

# make sure /dev/ has mounted
while [ ! -e /dev/mapper/control -o ! -e /proc/mounts ]
do
	usleep 10000
	echo .
done

# check a/b system
if [ ! -z "$(cat /proc/cmdline | grep android_slotsufix)" ]; then
	SLOT_SUFIX=$(cat /proc/cmdline | sed "s#.*android_slotsufix=##" | cut -d ' ' -f 1)
	SYSTEM_NAME=system
fi

DEBUG "system name is ${SYSTEM_NAME}${SLOT_SUFIX}"
mkdir -p /dev/block/by-name
BLOCK=$(find_raw_partition "${SYSTEM_NAME}${SLOT_SUFIX}")
USER_BLOCK=$(find_raw_partition "userdata")
#FACT_BLOCK=$(find_raw_partition "factory")
DEBUG "find system -> ${BLOCK}"
ln -s /dev/$BLOCK /dev/block/by-name/system
ln -s /dev/$USER_BLOCK /dev/block/by-name/userdata
#ln -s /dev/$FACT_BLOCK /dev/block/by-name/factory

OFFSET=
# encrypto partition should get size from dev
if [ -z "$OFFSET" ]; then
	OFFSET=$(cat /sys/class/block/${BLOCK}/size)
fi
if [ -z "$USER_OFFSET" ]; then
	USER_OFFSET=$(cat /sys/class/block/${USER_BLOCK}/size)
fi

#FACT_OFFSET=$(cat /sys/class/block/${FACT_BLOCK}/size)
DEBUG "OFFSET is ${OFFSET}"

HASH=
CIPHER=aes-cbc-plain
ENC_EN=true
FORCE_KEY_WRITE=false
FACTORY=false

exec 0</dev/console

DEBUG "try to find misc"
MISC_BLOCK=$(find_raw_partition "misc")
DEBUG "find misc -> $MISC_BLOCK"
ln -s /dev/$MISC_BLOCK /dev/block/by-name/misc
#if mount /dev/block/by-name/system /mnt >/dev/null 2>&1; then
#	umount /mnt
#	echo "0 $OFFSET linear /dev/block/by-name/system 0" | dmsetup create vroot
#	echo "0 $USER_OFFSET linear /dev/block/by-name/userdata 0" | dmsetup create vuserdata
#	ENC_EN=false
#fi

VOLTAGE=$(cat /sys/bus/iio/devices/iio:device0/in_voltage1_raw)

if [ "$VOLTAGE" -lt "500" ]; then
	MSG_OUTPUT=/dev/console
	FACTORY=true
	DEBUG "Entry factory mode"
fi


if [ "${ENC_EN}" = "true" ] && [ "${FACTORY}" = "false" ]; then
	/lib64/ld-linux-aarch64.so.1 /usr/bin/tee-supplicant &
	/lib64/ld-linux-aarch64.so.1 /usr/bin/keybox_app 1
	if [ "$?" != 0 ] || [ "$FORCE_KEY_WRITE" = "true" ]; then
		/usr/bin/updateEngine --misc_custom read
		if [ "$?" != 0 ]; then
			while true
			do
				DEBUG "Can't fetch key from misc, reboot !!!"
				reboot
				sleep 1
			done
		else
			mv /tmp/custom_cmdline /tmp/syspw
			while true
			do
				/lib64/ld-linux-aarch64.so.1 /usr/bin/keybox_app
				/lib64/ld-linux-aarch64.so.1 /usr/bin/keybox_app write
				if [ "$?" == 0 ]; then
					break
				fi
				sleep 1
			done
		fi
	fi
	KEY=`cat /tmp/syspw`
	dmsetup create vroot --table "0 ${OFFSET} crypt ${CIPHER} ${KEY} 0 /dev/block/by-name/system 0 1 allow_discards"
	dmsetup create vuserdata --table "0 ${USER_OFFSET} crypt ${CIPHER} ${KEY} 0 /dev/block/by-name/userdata 0 1 allow_discards"
	if [ "$?" == 0 ]; then
		/usr/bin/updateEngine --misc_custom clean
	fi
fi



if [ "${FACTORY}" = "true" ]; then
	entry_factory
else
	fsck.f2fs -f /dev/mapper/vuserdata
	resize.f2fs -F /dev/mapper/vuserdata
	mount /dev/mapper/vroot /rootfs
	mount -t f2fs -o defaults,noatime,nodiratime,background_gc=on,data_flush,checkpoint=enable,inline_xattr,inline_data /dev/mapper/vuserdata /userdata
	mkdir -p /userdata/overlay/upper
	mkdir -p /userdata/overlay/work
	mount -t overlay overlay -o rw,lowerdir=/rootfs,upperdir=/userdata/overlay/upper,workdir=/userdata/overlay/work /mnt
fi
if [ -e "/mnt/init" ]; then
	INIT=/init
else
	INIT=/sbin/init
fi
# exec /sbin/init "$@"
echo "exec busybox switch_root /mnt ${INIT}"
exec busybox switch_root /mnt ${INIT}
